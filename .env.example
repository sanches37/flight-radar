# 셸 환경변수로 읽힙니다. 앱이 .env를 자동으로 로드하지는 않습니다.
#   set -a; . .env; set +a   ← 이렇게 불러온 뒤 uv run
# GitHub Actions에서는 워크플로의 env: 블록이 시크릿을 주입합니다.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 오픈조(다구간) 수집용. Google이 다구간을 서버 렌더링하지 않아 이것만 가능.
# serpapi.com 무료 250회/월 — GitHub Actions에서는 Secrets에 SERPAPI_KEY 필요
SERPAPI_KEY=
